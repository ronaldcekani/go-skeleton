{
  "realm": "skeleton",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [{ "name": "user" }]
  },
  "clients": [
    {
      "clientId": "skeleton-cli",
      "name": "Local development client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "go-skeleton-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "go-skeleton",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "realmRoles": ["user"],
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    }
  ]
}
